FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY mt5_bridge/requirements.txt /app/mt5_bridge/requirements.txt
RUN pip install -r /app/mt5_bridge/requirements.txt

COPY mt5_bridge /app/mt5_bridge
COPY scripts /app/scripts

CMD ["python", "-m", "mt5_bridge.main"]
