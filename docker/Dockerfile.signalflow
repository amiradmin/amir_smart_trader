FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY signalflow_engine/requirements.txt /app/signalflow_engine/requirements.txt
RUN pip install -r /app/signalflow_engine/requirements.txt

COPY signalflow_engine /app/signalflow_engine
COPY scripts /app/scripts
COPY data /app/data

CMD ["python", "-m", "signalflow_engine.main"]
